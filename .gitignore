# ─────────────────────────────────────────────────────────────────────────────
# CorteX AI — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ─── Secrets & Credentials (CRITICAL: NEVER COMMIT) ─────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.cert
credentials.json
secrets/

# ─── Python / Bytecode ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─── Virtual Environments ───────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ─── Node / npm Dependencies ────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Generated Reports & Dynamic Investigation Artifacts ────────────────────
reports/*.pdf
reports/*.docx
!reports/.gitkeep

# ─── Vector DB Local Storage (ChromaDB) ─────────────────────────────────────
chroma_db/
chroma_data/
*.parquet

# ─── OS & Editor Artifacts ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.idea/
.vscode/
*.swp
*.swo
