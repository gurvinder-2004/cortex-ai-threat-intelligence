# ─── CorteX AI — Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in your keys
# cp .env.example .env

# ─── REQUIRED FOR INTELLIGENCE MODE ──────────────────────────────────────────

# Shodan — IP/host intelligence (free tier: 100 queries/month)
# https://account.shodan.io
SHODAN_API_KEY=

# VirusTotal — malware/IOC lookups (free: 500 req/day)
# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# OTX AlienVault — threat feed (free)
# https://otx.alienvault.com/api
OTX_API_KEY=

# ─── REQUIRED FOR BREACH RADAR — EMAIL LOOKUP ────────────────────────────────

# Hunter.io — email verification + domain search (FREE: 25/month, no CC needed)
# https://hunter.io/api-keys  ← get free key here
HUNTER_API_KEY=

# LeakCheck — email breach lookup (PAID required, free API discontinued)
# Plans start ~$4/mo: https://leakcheck.io/pricing
# If set, LeakCheck takes priority over Hunter for Email Lookup
LEAKCHECK_API_KEY=

# ─── OPTIONAL — BREACH RADAR DOMAIN SCAN ─────────────────────────────────────

# URLScan.io — web footprint scanning (free tier: 100 req/day, no key needed but recommended)
# https://urlscan.io/user/signup
URLSCAN_API_KEY=

# IntelX — phonebook/paste search (free tier limited, key gives more results)
# https://intelx.io/signup
INTELX_API_KEY=

# ─── OPTIONAL — INTELLIGENCE MODE EXTRAS ─────────────────────────────────────

# CISA KEV — no key needed (public API)
# ThreatFox — no key needed (public API)
# URLhaus — no key needed (public API)
# Ransomware.live — no key needed (public API)
# crt.sh — no key needed (public API)
# HackerTarget — no key needed (free tier, rate limited)

# ─── LLM (OLLAMA LOCAL OR GROQ CLOUD) ─────────────────────────────────────────
# Option A: Local Ollama (no key needed)
# Install: https://ollama.com/download
# Pull model: ollama pull mistral
OLLAMA_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434

# Option B: Groq Cloud (ultra-fast cloud inference, free tier at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
